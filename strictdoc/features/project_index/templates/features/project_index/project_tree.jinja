{%- if not view_object.is_empty_tree() or view_object.project_config.html_reports -%}
  <div class="project_tree" js-collapsible_tree>
    {% if view_object.project_config.html_reports %}
    <details class="project_tree-folder">
      <summary>
        <div class="project_tree-folder-title">
          {%- include "icons/ico16_folder.svg" -%}
          Reports/
          {%- include "icons/ico16_folder_collapse.svg" -%}
        </div>
      </summary>
      <div class="project_tree-folder">
        {% for report_type, reports in view_object.project_config.html_reports.items() %}
          <details open class="project_tree-folder">
            <summary>
              <div class="project_tree-folder-title">
                {%- include "icons/ico16_folder.svg" -%}
                {{ report_type }}/
                {%- include "icons/ico16_folder_collapse.svg" -%}
              </div>
            </summary>

            <div class="project_tree-folder-content">
            {% for report_name_, report_url_ in reports %}
              <a class="project_tree-file" href="{{ view_object.render_url(report_url_) }}" data-turbo="false" data-testid="report-link">
                <div class="project_tree-file-icon">{% include "icons/ico16_link.svg" %}</div>
                <div class="project_tree-file-details">
                  <div class="project_tree-file-title">{{ report_name_ }}</div>
                </div>
              </a>
              {% endfor %}
            </div>
          </details>
        {% endfor %}
      </div>
    </details>
    <div class="tree_folder" data-level="2" data-testid="tree-folder-item"></div>
    {% endif %}
    {% for root_tree_ in view_object.document_tree_iterator.document_tree.file_tree %}

      {% if root_tree_.root_folder_or_file.is_folder() %}
        {% if view_object.should_display_folder(root_tree_.root_folder_or_file) %}
          {% with folder = root_tree_.root_folder_or_file %}
            {% include "features/project_index/project_tree_folder.jinja" %}
          {% endwith %}
        {% endif %}
      {% else %}
        {% if view_object.should_display_file(root_tree_.root_folder_or_file) %}
          {% with file = root_tree_.root_folder_or_file %}
            {% include "features/project_index/project_tree_file.jinja" %}
          {% endwith %}
        {% endif %}
      {% endif %}

    {% endfor %}
  </div>
{%- else -%}
  <span data-testid="document-tree-empty-text">The document tree has no documents yet.</span>
{%- endif -%}
